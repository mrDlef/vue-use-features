{
  // Declaration-only pass over the published entry point.
  // Kept separate from tsconfig.app.json, which is `noEmit` + `composite`
  // and also covers the playground and the tests.
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/useFeatures.ts"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  }
}
